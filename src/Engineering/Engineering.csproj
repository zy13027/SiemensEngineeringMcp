<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <TiaApiVersion Condition="'$(TiaApiVersion)' == ''">21.0</TiaApiVersion>
    <_TiaApiRelative Condition="'$(TiaApiVersion)' == '21.0'">Siemens\Automation\Portal V21\PublicAPI\V21\net48</_TiaApiRelative>
    <_TiaApiRelative Condition="'$(TiaApiVersion)' == '21.1'">Siemens\Automation\Portal V21.1\PublicAPI\V21.1\net48</_TiaApiRelative>
    <!-- Prefer an explicit override, then the first Program Files root that actually contains the Openness assemblies. -->
    <TiaApiDirectory Condition="'$(TiaApiDirectory)' == '' And '$(SIEMENS_TIA_API_DIRECTORY)' != ''">$(SIEMENS_TIA_API_DIRECTORY)</TiaApiDirectory>
    <TiaApiDirectory Condition="'$(TiaApiDirectory)' == '' And Exists('$(ProgramFiles)\$(_TiaApiRelative)\Siemens.Engineering.Base.dll')">$(ProgramFiles)\$(_TiaApiRelative)</TiaApiDirectory>
    <TiaApiDirectory Condition="'$(TiaApiDirectory)' == '' And Exists('F:\Program Files\$(_TiaApiRelative)\Siemens.Engineering.Base.dll')">F:\Program Files\$(_TiaApiRelative)</TiaApiDirectory>
    <TiaApiDirectory Condition="'$(TiaApiDirectory)' == '' And Exists('D:\Program Files\$(_TiaApiRelative)\Siemens.Engineering.Base.dll')">D:\Program Files\$(_TiaApiRelative)</TiaApiDirectory>
    <TiaApiDirectory Condition="'$(TiaApiDirectory)' == '' And Exists('E:\Program Files\$(_TiaApiRelative)\Siemens.Engineering.Base.dll')">E:\Program Files\$(_TiaApiRelative)</TiaApiDirectory>
    <TiaApiDirectory Condition="'$(TiaApiDirectory)' == ''">$(ProgramFiles)\$(_TiaApiRelative)</TiaApiDirectory>
    <DefineConstants Condition="'$(TiaApiVersion)' == '21.1'">$(DefineConstants);TIA_21_1</DefineConstants>
    <OutputPath>bin\$(Configuration)\$(TiaApiVersion)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(TiaApiVersion)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\WorkerProtocol.cs" Link="WorkerProtocol.cs" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaApiDirectory)\Siemens.Engineering.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(TiaApiDirectory)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCCUnified">
      <HintPath>$(TiaApiDirectory)\Siemens.Engineering.WinCCUnified.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateSiemensApi" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TiaApiVersion)' != '21.0' And '$(TiaApiVersion)' != '21.1'" Text="TiaApiVersion must be 21.0 or 21.1." />
    <Error Condition="!Exists('$(TiaApiDirectory)\Siemens.Engineering.Base.dll')" Text="Set TiaApiDirectory to the installed TIA $(TiaApiVersion) x64 PublicAPI net48 directory." />
  </Target>
</Project>
